---js
const eleventyNavigation = {
	key: "Home",
	order: 1
};

const numberOfLatestPostsToShow = 9;
---

<h1>Anshul Chauhan</h1>

<p>
Hi! I am Anshul. I am a software craftsman(and other things).
</p>

<p>
Welcome to my personal corner of the web.
</p>


{% set publishedLists = collections.publishedLists %}
{% set publishedPosts = collections.publishedPosts %}
{% set postsCount = publishedPosts | length %}
{% set latestPostsCount = postsCount | min(numberOfLatestPostsToShow) %}
{% set postslist = publishedPosts | head(-1 * numberOfLatestPostsToShow) %}

<ul class="content-list">
{%- for item in publishedLists %}
	<li>
		<a href="{{ item.url }}">{% if item.data.title %}{{ item.data.title }}{% else %}<code>{{ item.url }}</code>{% endif %}</a>
	</li>
{%- endfor %}
{%- for post in postslist | reverse %}
	<li>
		<a href="{{ post.url }}">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
		<span>&nbsp;</span>
		<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLLL yyyy") }}</time>
	</li>
{%- endfor %}
</ul>

{% set morePosts = postsCount - numberOfLatestPostsToShow %}
{% if morePosts > 0 %}
<p>{{ morePosts }} more post{% if morePosts != 1 %}s{% endif %} can be found in <a href="blog.njk">the archive</a>.</p>
{% endif %}

